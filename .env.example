# ---- Backend ----
NODE_ENV=development
PORT=4000

# Postgres connection (local docker-compose uses the values below).
# For Supabase, paste the project's pooled connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pocket_locker?schema=public

# JWT
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=7d

# Supabase Storage (required for signed upload/download URLs)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_BUCKET=files

# CORS — allowed frontend origin
CORS_ORIGIN=http://localhost:5173

# ---- Frontend ----
VITE_API_URL=http://localhost:4000
