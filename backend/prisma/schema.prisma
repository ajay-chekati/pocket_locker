generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url = pooled connection (PgBouncer) used by the app at runtime.
  url      = env("DATABASE_URL")
  // directUrl = direct connection used by `prisma migrate` (can't run through
  // the pooler). For local dev without a pooler, set it to the same value.
  directUrl = env("DIRECT_URL")
}

enum Plan {
  free
  pro
}

enum FileStatus {
  pending
  ready
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  plan          Plan     @default(free)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())

  files File[]
}

/// One-time codes for email (signup) verification. Codes are hashed at rest.
model EmailOtp {
  id         String    @id @default(uuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}

model File {
  id          String     @id @default(uuid())
  userId      String
  name        String
  storagePath String     @unique
  size        Int // bytes
  mimeType    String
  status      FileStatus @default(pending)
  createdAt   DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes tuned for the list/filter/search queries (PR 3).
  @@index([userId, createdAt]) // recent / oldest
  @@index([userId, size]) // largest / smallest
  @@index([userId, name]) // filename search
}
