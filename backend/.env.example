# Backend environment (secrets — never shipped to the browser).
NODE_ENV=development
PORT=4000

# Postgres connection used by the app at runtime.
# - Local docker-compose: the value below.
# - Supabase: the *pooled* connection string (PgBouncer, port 6543),
#   e.g. postgresql://postgres.<ref>:<pwd>@<host>:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pocket_locker?schema=public

# Direct connection used by `prisma migrate` (cannot run through the pooler).
# - Local: same value as DATABASE_URL.
# - Supabase: the *direct* connection string (port 5432).
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/pocket_locker?schema=public

# JWT
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=7d

# Supabase Storage — used by @supabase/supabase-js for signed upload/download
# URLs (PR 2). This is the Storage/API service, NOT the database connection.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_BUCKET=files

# CORS — allowed frontend origin
CORS_ORIGIN=http://localhost:5173
